# upb configuration: /etc/upb/upb.conf on the Proxmox Backup Server VM.
# This file is sourced by bash: write VAR="value" with no spaces around '='.

# --- Unraid ----------------------------------------------------------------
UNRAID_HOST="192.168.1.180"
# NFS mount options. Must include "ro". "soft" makes an unreachable Unraid
# fail the backup (and notify you) instead of hanging it forever.
NFS_OPTIONS="ro,soft,timeo=600,retrans=2"
# Shares are mounted here while their backup runs, one folder per job.
MOUNT_ROOT="/mnt/upb"

# --- Proxmox Backup Server -------------------------------------------------
# upb runs on the PBS VM itself, so it talks to localhost.
PBS_SERVER="localhost"
PBS_PORT=8007
PBS_DATASTORE="unraid"
# Optional namespace inside the datastore. It must already exist.
PBS_NAMESPACE=""
# API token id (user@realm!token-name). pbs-setup.sh creates it and writes its
# secret to PBS_TOKEN_FILE.
PBS_AUTH_ID="unraid-backup@pbs!unraid"
PBS_TOKEN_FILE="/etc/upb/secrets/pbs-token"
# Filled in by pbs-setup.sh (or PBS web UI: Dashboard > Show Fingerprint).
PBS_FINGERPRINT=""

# --- Encryption ------------------------------------------------------------
# Off by default: the key would sit on this VM right next to the datastore, so
# it protects little, and unencrypted backups can be browsed and downloaded in
# the PBS web UI. Turn it on (after `upb init-key`) before you sync the
# datastore somewhere off site.
PBS_ENCRYPTION=false
PBS_KEYFILE="/etc/upb/secrets/encryption.key"

# --- Backup behaviour ------------------------------------------------------
# "metadata" only re-reads files whose metadata changed since the previous
# snapshot, which keeps nightly runs of big shares fast.
PBS_CHANGE_DETECTION_MODE="metadata"
# Backup groups are named host/<prefix>-<job>, e.g. host/unraid-photos.
BACKUP_ID_PREFIX="unraid"
# For jobs with WAIT_FOR_QUIET=true: wait until nothing in the share changed
# for QUIET_MINUTES (Appdata Backup still writing), and give up after
# QUIET_TIMEOUT_MINUTES.
QUIET_MINUTES=10
QUIET_TIMEOUT_MINUTES=180
# Extra flags added to every `proxmox-backup-client backup` call, as a bash
# array. See `upb client help backup`.
PBS_EXTRA_ARGS=()

# --- Logging and notifications ---------------------------------------------
# Logs also go to the journal: journalctl -u upb-backup
LOG_DIR="/var/log/upb"
LOG_KEEP_DAYS=30
# Email on failure, sent with this host's sendmail (postfix).
NOTIFY_EMAIL=""
# ntfy topic URL for push notifications, e.g. "https://ntfy.sh/my-backups".
NOTIFY_NTFY_URL=""
# Also notify when everything succeeded.
NOTIFY_ON_SUCCESS=false
# healthchecks.io-compatible URL, pinged at start, on success and on failure.
# It also alerts you when a backup never ran at all.
HEALTHCHECK_URL=""
