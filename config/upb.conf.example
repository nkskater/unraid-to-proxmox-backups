# upb configuration: /boot/config/upb/upb.conf
# This file is sourced by bash: write VAR="value" with no spaces around '='.

# --- Proxmox Backup Server -------------------------------------------------
# proxmox/pbs-setup.sh prints the values for this section.

# Host name or IP of the Proxmox Backup Server (e.g. "192.168.1.20").
PBS_SERVER=""
PBS_PORT=8007
# Datastore that receives the Unraid backups.
PBS_DATASTORE="unraid"
# Optional namespace inside the datastore. It must already exist on PBS.
PBS_NAMESPACE=""
# API token id (user@realm!token-name). Put the token secret in PBS_TOKEN_FILE.
PBS_AUTH_ID="unraid-backup@pbs!unraid"
PBS_TOKEN_FILE="/boot/config/upb/secrets/pbs-token"
# SHA-256 fingerprint of the PBS certificate (PBS web UI: Dashboard > Show Fingerprint).
PBS_FINGERPRINT=""

# --- Encryption ------------------------------------------------------------
# Client-side encryption: PBS only stores encrypted chunks. Create the key
# with `upb init-key` and keep an offline copy. Without the key, the backups
# cannot be restored.
# Trade-off: encrypted backups can't be browsed in the PBS web UI; use
# `upb shell` instead.
PBS_ENCRYPTION=true
PBS_KEYFILE="/boot/config/upb/secrets/encryption.key"

# --- Backup behaviour ------------------------------------------------------
# "metadata" only re-reads files whose metadata changed since the previous
# snapshot, which keeps nightly runs of large photo libraries fast. It needs
# client and server 3.3 or newer; use "legacy" for older servers.
PBS_CHANGE_DETECTION_MODE="metadata"
# Backup groups are named host/<prefix>-<job>, e.g. host/unraid-appdata.
BACKUP_ID_PREFIX="unraid"
# Where pre-backup hooks write database dumps (one folder per job). The latest
# dumps are kept here, so use a pool or array share, not RAM.
STAGING_DIR="/mnt/user/system/upb-staging"
# Seconds docker waits for a container to stop before killing it.
CONTAINER_STOP_TIMEOUT=60
# Extra flags added to every `proxmox-backup-client backup` call, as a bash
# array. See `upb client help backup` for what's available.
PBS_EXTRA_ARGS=()

# --- Logging and notifications ---------------------------------------------
# /var/log is in RAM on Unraid; point this at a share to keep logs across reboots.
LOG_DIR="/var/log/upb"
LOG_KEEP_DAYS=30
# Raise an Unraid notification when a backup fails. Where it goes (browser,
# email, Discord, ...) is set in Settings > Notifications.
NOTIFY_UNRAID=true
# Also notify when everything succeeded.
NOTIFY_ON_SUCCESS=false
# healthchecks.io-compatible URL. It is pinged at start, on success and on
# failure (with the end of the log), so you also hear about runs that never
# happened.
HEALTHCHECK_URL=""
