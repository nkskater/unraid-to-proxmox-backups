# Immich photo library: originals, uploads, profile pictures and Immich's own
# database backups. The live database is dumped by the databases job.
#
# To enable:
#   1. Docker tab > immich > Edit: find the host path mapped to /photos and
#      put it below.
#   2. Set JOB_ENABLED=true.
# The first run uploads the whole library. After that, only changes are sent.
JOB_ENABLED=false

SOURCES=(
  "photos:/mnt/user/photos"
)

EXCLUDES=(
  # Immich regenerates both of these.
  "/thumbs/"
  "/encoded-video/"
)
