# SQL dumps of the Postgres containers. pg_dump gives a consistent copy while
# the apps keep running; copying the raw database folder out of appdata doesn't.
# The dumps are written to $STAGING_DIR/databases and uploaded as the "dumps"
# archive.
JOB_ENABLED=true

SOURCES=()

pre_backup() {
  # dump_postgres <container> [user] [database]
  #   user:     the container's POSTGRES_USER (default: postgres)
  #   database: leave out to dump every database (pg_dumpall)
  dump_postgres PostgreSQL_Immich postgres
  dump_postgres postgresql17 postgres
}
