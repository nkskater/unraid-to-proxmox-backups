# Any other important share: documents, Syncthing folders, anything you
# couldn't download again. Make one copy of this file per share; the file name
# (minus the number) becomes the job and archive name.
JOB_ENABLED=false
EXPORT="/mnt/user/documents"

# gitignore-style patterns: a leading "/" anchors at the top of the share,
# "**" matches any depth, a trailing "/" matches directories only.
EXCLUDES=(
  "**/.Recycle.Bin/"
  "**/.stversions/"
)
