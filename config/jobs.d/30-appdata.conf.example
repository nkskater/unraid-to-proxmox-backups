# Container config and state in appdata: Home Assistant, the *arr apps, Plex,
# Jellyfin, Paperless, Karakeep and so on.
JOB_ENABLED=true

# Reading from the pool directly (e.g. /mnt/cache/appdata) skips the
# user-share layer and is faster.
SOURCES=(
  "appdata:/mnt/user/appdata"
)

# gitignore-style patterns: a leading "/" anchors at the top of the archive,
# "**" matches any depth, and a trailing "/" matches directories only.
# To see what's big: du -sh /mnt/user/appdata/* | sort -h
EXCLUDES=(
  # Plex rebuilds these on its own
  "**/Plex Media Server/Cache/"
  "**/Plex Media Server/Codecs/"
  "**/Plex Media Server/Crash Reports/"
  "**/Plex Media Server/Logs/"
  "**/Plex Media Server/Updates/"
  # Transcoding scratch space and logs
  "**/transcodes/"
  "**/*.log"
  # Raw Postgres data folders aren't safe to copy while the database runs; the
  # databases job dumps them instead. Uncomment once that job works, using
  # the folder names you see in appdata:
  # "/PostgreSQL_Immich/"
  # "/postgresql17/"
)

# Containers to stop while this job runs. They are started again afterwards,
# even if the backup fails. Stopping gives a clean copy of SQLite databases.
# Many apps also write their own backups (the *arr apps to /config/Backups,
# Home Assistant to /config/backups), and those get backed up either way.
STOP_CONTAINERS=(
  # homeassistant
  # binhex-sonarr
  # binhex-radarr
)
