# Immich photo library: the host folder mapped to /photos in the immich
# container. Holds originals, uploads, profile pictures and Immich's own
# nightly database dumps (backups/).
#
# To enable: check the path (Docker tab > immich > Edit), export that share
# to this VM, then set JOB_ENABLED=true. The first run reads the whole
# library; after that only changes are read.
JOB_ENABLED=false
EXPORT="/mnt/user/photos"

EXCLUDES=(
  # Immich regenerates both of these.
  "/thumbs/"
  "/encoded-video/"
)
