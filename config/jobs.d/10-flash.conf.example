# Unraid flash drive: disk assignments, share and network settings, Docker
# templates, plugins and the license key. Small, and the first thing you need
# when rebuilding the server.
JOB_ENABLED=true

SOURCES=(
  "flash:/boot"
)

EXCLUDES=(
  # Previous Unraid release, kept only for rolling back an update.
  "/previous/"
  # PBS token and encryption key. A key stored inside the backups it encrypts
  # is no use, so keep your own offline copy instead.
  "/config/upb/secrets/"
)
