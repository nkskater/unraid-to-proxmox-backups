# Paperless-ngx. Its document exporter writes every document plus a manifest
# that `document_importer` can load into a fresh install, independent of the
# Paperless version and database.
#
# To enable:
#   1. Docker tab > paperless-ngx > Edit: find the host path mapped to
#      /usr/src/paperless/export and put it below.
#   2. Set JOB_ENABLED=true.
JOB_ENABLED=false

SOURCES=(
  "export:/mnt/user/appdata/paperless-ngx/export"
)

pre_backup() {
  # --delete removes files for documents that were deleted in Paperless.
  docker_exec paperless-ngx document_exporter ../export --delete
}
