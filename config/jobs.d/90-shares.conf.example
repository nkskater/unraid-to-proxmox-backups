# Important user shares: documents, Syncthing folders, anything you couldn't
# download again. The media library is left out on purpose: it is huge and
# can be downloaded again.
#
# Add your shares, then set JOB_ENABLED=true. Each entry becomes its own
# archive in the snapshot.
JOB_ENABLED=false

SOURCES=(
  # "documents:/mnt/user/documents"
  # "syncthing:/mnt/user/syncthing"
)

EXCLUDES=(
  "**/.Recycle.Bin/"
  "**/.stversions/"
)
