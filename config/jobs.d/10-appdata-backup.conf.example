# Appdata Backup plugin output: one archive per container, taken with the
# container stopped, so databases are consistent.
# Must match the plugin's destination (Settings > Appdata Backup).
JOB_ENABLED=true
EXPORT="/mnt/user/Backup/appdata backup"

# The plugin keeps a dated folder per run. Only the newest run is read: PBS
# keeps the history itself, and the older folders are just older copies.
ONLY_NEWEST=1

# The plugin writes here for a while each run. Wait until it has finished, so
# a half-written archive is never captured.
WAIT_FOR_QUIET=true
