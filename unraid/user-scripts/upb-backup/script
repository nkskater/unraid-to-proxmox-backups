#!/bin/bash
#description=Back up important data to Proxmox Backup Server (upb)
#arrayStarted=true
#noParity=true
# Installed by install.sh. Set a schedule in Settings > User Scripts,
# e.g. Custom: 0 3 * * *

UPB=/boot/config/upb/app/bin/upb

# Recreate the `upb` command, which lives in RAM and is lost on reboot.
if [[ ! -x /usr/local/bin/upb ]]; then
  printf '#!/bin/bash\nexec bash %q "$@"\n' "$UPB" >/usr/local/bin/upb
  chmod 0755 /usr/local/bin/upb
fi

exec bash "$UPB" backup
