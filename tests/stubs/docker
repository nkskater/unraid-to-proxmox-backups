#!/usr/bin/env bash
# Test double for docker.
#   STUB_DOCKER_RUNNING  space-separated running containers
#   STUB_DOCKER_KNOWN    space-separated existing containers (default: running ones)
#   STUB_DOCKER_FAIL     space-separated "<command>:<container>" pairs that fail
printf 'docker %s\n' "$*" >>"${STUB_LOG:?}"
known=" ${STUB_DOCKER_KNOWN:-${STUB_DOCKER_RUNNING:-}} "
running=" ${STUB_DOCKER_RUNNING:-} "
fails=" ${STUB_DOCKER_FAIL:-} "

case $1 in
  inspect)
    if [[ $2 == -f ]]; then c=$4; else c=$2; fi
    [[ $known == *" $c "* ]] || exit 1
    if [[ $2 == -f ]]; then
      if [[ $running == *" $c "* ]]; then echo true; else echo false; fi
    fi
    ;;
  stop | start)
    c=${!#}
    [[ $fails == *" $1:$c "* ]] && exit 1
    echo "$c"
    ;;
  exec)
    c=$2
    [[ $fails == *" exec:$c "* ]] && exit 1
    echo "-- output of: ${*:3}"
    ;;
esac
exit 0
