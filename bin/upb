#!/usr/bin/env bash
# upb: pull important Unraid shares into Proxmox Backup Server.
# Runs on the PBS host; mounts each share read-only over NFS and backs it up.
set -uo pipefail

UPB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
UPB_VERSION="$(cat "$UPB_ROOT/VERSION" 2>/dev/null || echo dev)"

# shellcheck source=lib/common.sh
source "$UPB_ROOT/lib/common.sh"
# shellcheck source=lib/pbs.sh
source "$UPB_ROOT/lib/pbs.sh"
# shellcheck source=lib/nfs.sh
source "$UPB_ROOT/lib/nfs.sh"
# shellcheck source=lib/notify.sh
source "$UPB_ROOT/lib/notify.sh"
# shellcheck source=lib/jobs.sh
source "$UPB_ROOT/lib/jobs.sh"
# shellcheck source=lib/offsite.sh
source "$UPB_ROOT/lib/offsite.sh"
# shellcheck source=lib/host.sh
source "$UPB_ROOT/lib/host.sh"

usage() {
  cat <<EOF
Usage: upb [--config-dir DIR] <command> [args]

Pull important Unraid shares into Proxmox Backup Server.

Commands:
  backup [--dry-run] [JOB...]   Run all enabled jobs, or only the named ones
  list                          Show the configured jobs
  check                         Validate config, test PBS and mount every enabled export
  snapshots [JOB]               List snapshots on PBS
  restore JOB DIR [SNAPSHOT]    Restore a job's backup into an empty local DIR
                                (latest snapshot unless SNAPSHOT is given)
  mount JOB DIR [SNAPSHOT]      Mount a backup read-only at DIR (unmount: umount DIR)
  shell JOB [SNAPSHOT]          Browse a backup and restore single files
  init-key                      Create a client-side encryption key
  client ARGS...                Run proxmox-backup-client against the configured
                                repository, e.g. "upb client snapshot list"

Offsite copies (restic, e.g. to Google Drive; see docs/offsite.md):
  offsite [--dry-run] [JOB...]  Copy all enabled jobs offsite, or only the named ones
  offsite-init                  Create the offsite repository (once)
  restic ARGS...                Run restic against the offsite repository,
                                e.g. "upb restic snapshots"

On a Proxmox VE node (install.sh --pve-host; see docs/pve-host-backup.md):
  host-backup [--dry-run]       Back up this node's configuration to PBS
  host-restore DIR [SNAPSHOT]   Restore this node's latest (or the given)
                                configuration backup into an empty DIR
  host-client ARGS...           Run proxmox-backup-client against the host
                                backup repository

  version                       Print the upb version

Config directory: $UPB_CONFIG_DIR (change it with --config-dir or UPB_CONFIG_DIR)
EOF
}

# Loads and validates the config and finds the client: needed by every command
# that talks to PBS.
prepare_pbs() {
  load_config
  validate_config || die "fix the settings above in $UPB_CONFIG_DIR/upb.conf"
  ensure_client || exit 1
}

# abort_run <subject> <message> — aborts a run, making sure the failure is
# reported, not just logged.
abort_run() {
  error "$2"
  if ! dry_run; then
    notify failure "$1" "$2"
    healthcheck_ping fail "$UPB_LOG_FILE"
  fi
  exit 1
}

# parse_run_args <names-array> "$@" — handles --dry-run and collects job names.
parse_run_args() {
  local -n _names=$1
  shift
  while (($#)); do
    case $1 in
      -n | --dry-run) UPB_DRY_RUN=true ;;
      -*) die "unknown option: $1" ;;
      *) _names+=("$1") ;;
    esac
    shift
  done
}

# select_jobs <files-array> <pbs|offsite> [NAME...] — the named jobs, or every
# enabled job that goes to the destination.
select_jobs() {
  local -n _files=$1
  local dest=$2 f name
  shift 2
  if (($#)); then
    for name in "$@"; do
      f=$(find_job_file "$name") || die "unknown job: $name (see: upb list)"
      job_goes_to "$f" "$dest" ||
        die "job $name is not copied to $dest (see PBS_BACKUP and OFFSITE_BACKUP in its file)"
      _files+=("$f")
    done
  else
    while IFS= read -r f; do
      if job_enabled "$f" && job_goes_to "$f" "$dest"; then _files+=("$f"); fi
    done < <(job_files)
  fi
  ((${#_files[@]})) || die "no enabled jobs for $dest in $UPB_CONFIG_DIR/jobs.d"
}

# record_result <name> <exit-code> <start-seconds> — adds a summary line to
# RESULTS and counts failures in FAILED.
record_result() {
  if (($2 == 0)); then
    RESULTS+=("OK    $1 ($(format_duration $((SECONDS - $3))))")
  else
    RESULTS+=("FAIL  $1 (exit $2)")
    FAILED=$((FAILED + 1))
  fi
}

# run_job_files <runner> <file>... — runs each job in its own subshell, so jobs
# can't leak settings or traps into each other.
run_job_files() {
  local runner=$1 f name start
  shift
  for f in "$@"; do
    name=$(job_name "$f")
    start=$SECONDS
    info "=== $name ==="
    ("$runner" "$f")
    record_result "$name" $? "$start"
  done
}

# finish_run <subject-prefix> <what> — prints the summary and notifies.
finish_run() {
  local prefix=$1 what=$2 line summary
  info "=== summary ==="
  for line in "${RESULTS[@]}"; do info "$line"; done
  dry_run && return "$((FAILED > 0))"

  printf -v summary '%s\n' "${RESULTS[@]}"
  summary+="Log: $UPB_LOG_FILE"
  if ((FAILED)); then
    notify failure "$prefix: $FAILED of ${#RESULTS[@]} $what failed" "$summary"
    healthcheck_ping fail "$UPB_LOG_FILE"
    return 1
  fi
  if [[ $NOTIFY_ON_SUCCESS == true ]]; then
    notify success "$prefix: ${#RESULTS[@]} $what OK" "$summary"
  fi
  healthcheck_ping "" "$UPB_LOG_FILE"
}

cmd_backup() {
  local -a names=() files=()
  RESULTS=()
  FAILED=0
  parse_run_args names "$@"

  load_config
  validate_config ||
    abort_run "upb: backup did not run" "invalid configuration in $UPB_CONFIG_DIR/upb.conf (run: upb check)"
  select_jobs files pbs "${names[@]}"

  dry_run || setup_logging backup
  acquire_lock
  if ! dry_run; then
    ensure_client || abort_run "upb: backup did not run" "proxmox-backup-client is missing"
    healthcheck_ping start
  fi
  info "upb $UPB_VERSION: ${#files[@]} job(s) from $UNRAID_HOST to $(pbs_repository)${PBS_NAMESPACE:+ ns=$PBS_NAMESPACE}"
  run_job_files run_job "${files[@]}"
  finish_run "upb" "backup job(s)"
}

cmd_offsite() {
  local -a names=() files=()
  local start
  RESULTS=()
  FAILED=0
  parse_run_args names "$@"

  load_config
  # Offsite runs report to their own check, so a slow upload never looks like
  # a missed backup (and the other way round).
  HEALTHCHECK_URL=$OFFSITE_HEALTHCHECK_URL
  [[ $OFFSITE_ENABLED == true ]] ||
    die "offsite copies are off: set OFFSITE_ENABLED=true in $UPB_CONFIG_DIR/upb.conf (see docs/offsite.md)"
  validate_offsite_config ||
    abort_run "upb offsite: did not run" "invalid offsite configuration in $UPB_CONFIG_DIR/upb.conf (run: upb check)"
  select_jobs files offsite "${names[@]}"

  dry_run || setup_logging offsite
  acquire_lock "$OFFSITE_LOCK_FILE"
  if ! dry_run; then
    ensure_restic || abort_run "upb offsite: did not run" "restic or rclone is missing"
    healthcheck_ping start
  fi
  info "upb $UPB_VERSION offsite: ${#files[@]} job(s) from $UNRAID_HOST to $OFFSITE_REPOSITORY"
  run_job_files run_offsite_job "${files[@]}"

  # Retention and checks cover the whole repository, so they only run with
  # the full set of jobs, not for a quick "upb offsite JOB".
  if ((${#names[@]} == 0)); then
    info "=== retention ==="
    start=$SECONDS
    offsite_maintenance
    record_result retention $? "$start"
  fi
  finish_run "upb offsite" "step(s)"
}

cmd_offsite_init() {
  load_config
  validate_offsite_config || die "fix the settings above in $UPB_CONFIG_DIR/upb.conf"
  ensure_restic || exit 1
  if restic_run cat config >/dev/null 2>&1; then
    info "the offsite repository already exists: $OFFSITE_REPOSITORY"
    return 0
  fi
  info "creating the offsite repository $OFFSITE_REPOSITORY"
  restic_run init || die "restic init failed"
  cat <<EOF

IMPORTANT: the offsite copy can only be read with the password in
$OFFSITE_PASSWORD_FILE. Keep a copy somewhere other than this VM, e.g. in
your password manager.
EOF
}

cmd_restic() {
  load_config
  validate_offsite_config || die "fix the settings above in $UPB_CONFIG_DIR/upb.conf"
  ensure_restic || exit 1
  restic_run "$@"
}

cmd_host_backup() {
  local -a names=()
  local start
  RESULTS=()
  FAILED=0
  parse_run_args names "$@"
  ((${#names[@]} == 0)) || die "usage: upb host-backup [--dry-run]"

  load_host_config
  validate_host_config ||
    abort_run "upb host-backup: did not run" "invalid configuration in $UPB_CONFIG_DIR/host-backup.conf"

  dry_run || setup_logging host-backup
  acquire_lock
  if ! dry_run; then
    ensure_client || abort_run "upb host-backup: did not run" "proxmox-backup-client is missing"
    healthcheck_ping start
  fi
  info "upb $UPB_VERSION: configuration of $(hostname) to $(pbs_repository)${PBS_NAMESPACE:+ ns=$PBS_NAMESPACE}"
  start=$SECONDS
  (run_host_backup)
  record_result "host/$HOST_BACKUP_ID" $? "$start"
  finish_run "upb host-backup" "backup(s)"
}

cmd_host_restore() {
  (($# >= 1)) || die "usage: upb host-restore DIR [SNAPSHOT]"
  local target=$1 snapshot=${2:-} name rc=0
  load_host_config
  validate_host_config || die "fix the settings above in $UPB_CONFIG_DIR/host-backup.conf"
  ensure_client || exit 1
  if [[ -e $target && -n $(find "$target" -mindepth 1 -print -quit 2>/dev/null) ]]; then
    die "$target is not empty; restore into a new directory"
  fi
  while IFS= read -r name; do
    local -a args=(restore "${snapshot:-host/$HOST_BACKUP_ID}" "$name.pxar" "$target/$name")
    add_ns_args args
    add_key_args args
    info "restoring $name.pxar into $target/$name"
    if ! pbs_client "${args[@]}"; then
      warn "could not restore $name.pxar (not in this snapshot?)"
      rc=1
    fi
  done < <(host_archive_names)
  info "nothing on this host was changed; copy back what you need (see docs/pve-host-backup.md)"
  return "$rc"
}

cmd_host_client() {
  load_host_config
  validate_host_config || die "fix the settings above in $UPB_CONFIG_DIR/host-backup.conf"
  ensure_client || exit 1
  pbs_client "$@"
}

cmd_list() {
  local f
  load_config
  printf '%-18s %-8s %-30s %-8s %s\n' JOB ENABLED "PBS GROUP" OFFSITE EXPORT
  while IFS= read -r f; do
    (
      load_job "$f" >/dev/null 2>&1
      group="host/$BACKUP_ID" offsite=$OFFSITE_BACKUP
      [[ $PBS_BACKUP == true ]] || group="-"
      [[ $OFFSITE_ENABLED == true ]] || offsite="off"
      printf '%-18s %-8s %-30s %-8s %s\n' "$JOB_NAME" "$JOB_ENABLED" "$group" "$offsite" "$UNRAID_HOST:$EXPORT"
    )
  done < <(job_files)
}

cmd_check() {
  local f rc=0 out
  load_config
  info "config:     $UPB_CONFIG_DIR/upb.conf"
  info "unraid:     $UNRAID_HOST (NFS options: $NFS_OPTIONS)"
  info "repository: $(pbs_repository)${PBS_NAMESPACE:+ (namespace $PBS_NAMESPACE)}"
  info "encryption: $PBS_ENCRYPTION"
  validate_config || rc=1

  if ensure_client; then
    if ((rc == 0)); then
      if out=$(pbs_client version 2>&1); then
        info "PBS reachable and token accepted:"
        printf '  %s\n' "$out"
      else
        error "cannot talk to PBS:"
        printf '  %s\n' "$out" >&2
        rc=1
      fi
    fi
  else
    rc=1
  fi

  if [[ $OFFSITE_ENABLED == true ]]; then
    info "offsite:    $OFFSITE_REPOSITORY"
    if validate_offsite_config && ensure_restic; then
      if out=$(restic_run cat config 2>&1); then
        info "offsite repository reachable"
      else
        error "cannot open the offsite repository (new? run: upb offsite-init):"
        printf '  %s\n' "$out" >&2
        rc=1
      fi
    else
      rc=1
    fi
  fi

  if [[ -n $UNRAID_HOST ]] && command -v showmount >/dev/null; then
    if out=$(showmount -e "$UNRAID_HOST" 2>&1); then
      info "NFS exports offered by $UNRAID_HOST:"
      printf '  %s\n' "$out"
    else
      warn "showmount -e $UNRAID_HOST failed (is NFS enabled on Unraid?): $out"
    fi
  fi

  while IFS= read -r f; do
    if ! job_enabled "$f"; then
      info "job $(job_name "$f"): disabled"
    elif (check_job "$f"); then
      info "job $(job_name "$f"): ok"
    else
      rc=1
    fi
  done < <(job_files)

  if ((rc == 0)); then
    info "all checks passed"
  fi
  return "$rc"
}

cmd_snapshots() {
  local -a args=(snapshot list)
  local id
  prepare_pbs
  if (($#)); then
    id=$(job_backup_id "$1") || exit 1
    args+=("host/$id")
  fi
  add_ns_args args
  pbs_client "${args[@]}"
}

cmd_restore() {
  (($# >= 2)) || die "usage: upb restore JOB DIR [SNAPSHOT]"
  local job=$1 target=$2 snapshot=${3:-} id
  prepare_pbs
  id=$(job_backup_id "$job") || exit 1
  if [[ -e $target && -n $(find "$target" -mindepth 1 -print -quit 2>/dev/null) ]]; then
    die "$target is not empty; restore into a new directory"
  fi
  local -a args=(restore "${snapshot:-host/$id}" "$job.pxar" "$target")
  add_ns_args args
  add_key_args args
  info "restoring $job.pxar from ${snapshot:-the latest snapshot of host/$id} into $target"
  pbs_client "${args[@]}"
}

cmd_mount() {
  (($# >= 2)) || die "usage: upb mount JOB DIR [SNAPSHOT]"
  local job=$1 target=$2 snapshot=${3:-} id
  prepare_pbs
  id=$(job_backup_id "$job") || exit 1
  mkdir -p "$target" || die "cannot create $target"
  local -a args=(mount "${snapshot:-host/$id}" "$job.pxar" "$target")
  add_ns_args args
  add_key_args args
  pbs_client "${args[@]}" || exit 1
  info "mounted at $target (read-only); unmount with: umount $target"
}

cmd_shell() {
  (($# >= 1)) || die "usage: upb shell JOB [SNAPSHOT]"
  local job=$1 snapshot=${2:-} id
  prepare_pbs
  id=$(job_backup_id "$job") || exit 1
  local -a args=(catalog shell "${snapshot:-host/$id}" "$job.pxar")
  add_ns_args args
  add_key_args args
  pbs_client "${args[@]}"
}

cmd_init_key() {
  load_config
  [[ -e $PBS_KEYFILE ]] &&
    die "$PBS_KEYFILE already exists; replacing it would make existing backups unrestorable"
  ensure_client || exit 1
  mkdir -p "$(dirname "$PBS_KEYFILE")" || die "cannot create $(dirname "$PBS_KEYFILE")"
  "$PBS_CLIENT" key create "$PBS_KEYFILE" --kdf none || die "key creation failed"
  chmod 600 "$PBS_KEYFILE"
  info "created $PBS_KEYFILE; set PBS_ENCRYPTION=true in upb.conf to use it"
  echo
  echo "Paper copy of the key. Print it or store it in a password manager:"
  "$PBS_CLIENT" key paperkey "$PBS_KEYFILE" --output-format text
  cat <<EOF

IMPORTANT: encrypted backups can only be restored with this key. Keep a copy
somewhere other than this VM.
EOF
}

cmd_client() {
  prepare_pbs
  pbs_client "$@"
}

main() {
  while (($#)); do
    case $1 in
      --config-dir)
        UPB_CONFIG_DIR=${2:?--config-dir needs a directory}
        shift 2
        ;;
      -h | --help | help)
        usage
        return 0
        ;;
      -*) die "unknown option: $1 (see: upb --help)" ;;
      *) break ;;
    esac
  done
  (($#)) || {
    usage
    return 1
  }

  local cmd=$1
  shift
  case $cmd in
    backup) cmd_backup "$@" ;;
    list) cmd_list "$@" ;;
    check) cmd_check "$@" ;;
    snapshots) cmd_snapshots "$@" ;;
    restore) cmd_restore "$@" ;;
    mount) cmd_mount "$@" ;;
    shell) cmd_shell "$@" ;;
    init-key) cmd_init_key "$@" ;;
    client) cmd_client "$@" ;;
    offsite) cmd_offsite "$@" ;;
    offsite-init) cmd_offsite_init "$@" ;;
    restic) cmd_restic "$@" ;;
    host-backup) cmd_host_backup "$@" ;;
    host-restore) cmd_host_restore "$@" ;;
    host-client) cmd_host_client "$@" ;;
    version) echo "upb $UPB_VERSION" ;;
    *) die "unknown command: $cmd (see: upb --help)" ;;
  esac
}

main "$@"
